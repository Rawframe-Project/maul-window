{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/out/${presetName}",
      "cacheVariables": { "MAUL_WINDOW_WERROR": "ON" }
    },
    {
      "name": "linux",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "gcc",
      "hidden": true,
      "cacheVariables": { "CMAKE_C_COMPILER": "gcc-14", "CMAKE_CXX_COMPILER": "g++-14" }
    },
    {
      "name": "clang",
      "hidden": true,
      "cacheVariables": { "CMAKE_C_COMPILER": "clang-20", "CMAKE_CXX_COMPILER": "clang++-20" }
    },
    {
      "name": "linux-gcc-14",
      "displayName": "GCC 14, Release, Wayland and X11",
      "inherits": ["linux", "gcc"],
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "linux-clang-20",
      "displayName": "Clang 20, Release, Wayland and X11",
      "inherits": ["linux", "clang"],
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "linux-clang-20-asan",
      "displayName": "Clang 20, AddressSanitizer and UBSan, assertions on",
      "inherits": ["linux", "clang"],
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "MAUL_WINDOW_SANITIZE": "ON" }
    },
    {
      "name": "linux-clang-20-tsan",
      "displayName": "Clang 20, ThreadSanitizer, assertions on",
      "inherits": ["linux", "clang"],
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "MAUL_WINDOW_TSAN": "ON" }
    },
    {
      "name": "linux-shared",
      "displayName": "Clang 20, shared library",
      "inherits": ["linux", "clang"],
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "MAUL_WINDOW_BUILD_SHARED": "ON" }
    },
    {
      "name": "linux-minimal",
      "displayName": "GCC 14, no window system and no gamepads: the test backend alone",
      "inherits": ["linux", "gcc"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MAUL_WINDOW_WAYLAND": "OFF",
        "MAUL_WINDOW_X11": "OFF",
        "MAUL_WINDOW_GAMEPAD": "OFF"
      }
    },
    {
      "name": "web-wasi",
      "displayName": "Clang 20 for wasm32-wasi, tests in headless Chrome",
      "inherits": "linux",
      "toolchainFile": "${sourceDir}/cmake/wasm32-wasi.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "CMAKE_C_COMPILER": "clang-20" }
    },
    {
      "name": "web-emscripten",
      "displayName": "Emscripten, tests in headless Chrome",
      "inherits": "linux",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "android-emulator",
      "displayName": "NDK for x86_64, tests in the Android emulator",
      "inherits": "linux",
      "toolchainFile": "${sourceDir}/cmake/android-emulator.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "macos-clang",
      "displayName": "Apple Clang, Release",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "ios-simulator",
      "displayName": "Apple Clang for the iOS simulator, tests in a booted simulator",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "toolchainFile": "${sourceDir}/cmake/ios-simulator.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "windows-clang-cl",
      "displayName": "clang-cl through Visual Studio's ClangCL toolset",
      "inherits": "base",
      "toolset": { "value": "ClangCL", "strategy": "set" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    }
  ],
  "buildPresets": [
    { "name": "linux-gcc-14", "configurePreset": "linux-gcc-14" },
    { "name": "linux-clang-20", "configurePreset": "linux-clang-20" },
    { "name": "linux-clang-20-asan", "configurePreset": "linux-clang-20-asan" },
    { "name": "linux-clang-20-tsan", "configurePreset": "linux-clang-20-tsan" },
    { "name": "linux-shared", "configurePreset": "linux-shared" },
    { "name": "linux-minimal", "configurePreset": "linux-minimal" },
    { "name": "web-wasi", "configurePreset": "web-wasi" },
    { "name": "web-emscripten", "configurePreset": "web-emscripten" },
    { "name": "android-emulator", "configurePreset": "android-emulator" },
    { "name": "macos-clang", "configurePreset": "macos-clang" },
    { "name": "ios-simulator", "configurePreset": "ios-simulator" },
    { "name": "windows-clang-cl", "configurePreset": "windows-clang-cl", "configuration": "Release" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "timeout": 300, "jobs": 4 }
    },
    {
      "name": "linux",
      "hidden": true,
      "inherits": "base",
      "filter": { "exclude": { "label": "^uinput$" } }
    },
    { "name": "linux-gcc-14", "inherits": "linux", "configurePreset": "linux-gcc-14" },
    { "name": "linux-clang-20", "inherits": "linux", "configurePreset": "linux-clang-20" },
    { "name": "linux-clang-20-asan", "inherits": "linux", "configurePreset": "linux-clang-20-asan" },
    { "name": "linux-clang-20-tsan", "inherits": "linux", "configurePreset": "linux-clang-20-tsan" },
    { "name": "linux-shared", "inherits": "linux", "configurePreset": "linux-shared" },
    { "name": "linux-minimal", "inherits": "linux", "configurePreset": "linux-minimal" },
    { "name": "web-wasi", "inherits": "base", "configurePreset": "web-wasi" },
    { "name": "web-emscripten", "inherits": "base", "configurePreset": "web-emscripten" },
    {
      "name": "android-emulator",
      "inherits": "base",
      "configurePreset": "android-emulator",
      "execution": { "jobs": 1, "timeout": 240 }
    },
    { "name": "macos-clang", "inherits": "base", "configurePreset": "macos-clang" },
    {
      "name": "ios-simulator",
      "inherits": "base",
      "configurePreset": "ios-simulator",
      "execution": { "jobs": 1, "timeout": 240 }
    },
    {
      "name": "windows-clang-cl",
      "inherits": "base",
      "configurePreset": "windows-clang-cl",
      "configuration": "Release",
      "execution": { "jobs": 1 }
    }
  ]
}
